# Copia este archivo a `.env` (local y, cuando haya dominio, en el droplet). NO lo commitees.
# Comentarios siempre en su propia línea: `node --env-file` (npm run db:migrate, node build en local)
# NO quita los que van al final de la línea y los deja pegados al valor.

# Puerto de esta app: el mismo en el droplet y en el dev local (vite.config.ts)
PORT=4000
# Siempre localhost; nginx hace el proxy reverso
HOST=127.0.0.1
# Requerido por SvelteKit para aceptar POST/form-actions en prod (en el droplet: https://<dominio>)
ORIGIN=http://localhost:4000
# SQLite (better-sqlite3 + drizzle)
DATABASE_URL=./local.db
# Si tu app tiene panel admin
# ADMIN_PASSWORD=
